# 대표 주소는 site.config.ts에 고정됩니다. 이 값은 생략해도 됩니다.
VITE_SITE_URL=https://www.dashiform.com
# 내부 검토용 배포는 disabled. Cloudflare의 main 외 브랜치는 자동 noindex입니다.
VITE_INDEXING=enabled
# 검색엔진이 제공한 공개 소유권 확인 토큰. 도메인 DNS 인증을 쓰면 생략합니다.
VITE_GOOGLE_SITE_VERIFICATION=
VITE_BING_SITE_VERIFICATION=
VITE_NAVER_SITE_VERIFICATION=
