{
  "name": "reform-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "react-router dev --host 127.0.0.1",
    "build": "react-router build && node scripts/finalize-build.mjs && npm run check:ssg",
    "preview": "wrangler pages dev build/client --ip 127.0.0.1",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "vitest run",
    "check:ssg": "node --test tests/ssg.test.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "audit:live": "node scripts/audit-live.mjs",
    "deploy": "npm run check && wrangler pages deploy build/client"
  },
  "dependencies": {
    "isbot": "5.2.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@react-router/dev": "8.4.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "27.4.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "wrangler": "4.151.0"
  }
}
